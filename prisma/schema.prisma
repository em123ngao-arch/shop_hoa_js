generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banners {
  id            String  @id @db.VarChar(36)
  title         String  @db.VarChar(255)
  image_url     String  @db.VarChar(255)
  link_url      String? @db.VarChar(255)
  display_order Int     @default(0)
  is_active     Boolean @default(true)
  tag           String? @db.VarChar(100)
  description   String? @db.Text
  theme         String? @default("default") @db.VarChar(50)
  cta_text      String? @default("Khám Phá Các Mẫu Hoa") @db.VarChar(100)
}

model categories {
  id          String     @id @db.VarChar(36)
  name        String     @db.VarChar(100)
  slug        String     @unique(map: "idx_categories_slug") @db.VarChar(100)
  description String?    @db.Text
  products    products[]
}

model notifications {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(64)
  order_id   String?  @db.VarChar(36)
  title      String   @db.VarChar(200)
  message    String   @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
  orders     orders?  @relation(fields: [order_id], references: [id], map: "fk_notif_order")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notif_user")

  @@index([order_id], map: "fk_notif_order")
  @@index([user_id], map: "fk_notif_user")
  @@index([user_id, is_read], map: "idx_notif_user_read")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                String              @id @db.VarChar(36)
  order_id          String              @db.VarChar(36)
  product_id        String              @db.VarChar(36)
  product_name      String              @db.VarChar(200)
  quantity          Int                 @default(1)
  unit_price        Int
  cost_price        Int                 @default(0)
  orders            orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_order_items_order")
  products          products            @relation(fields: [product_id], references: [id], onDelete: NoAction, map: "fk_order_items_product")
  order_item_addons order_item_addons[]

  @@index([order_id], map: "fk_order_items_order")
  @@index([product_id], map: "fk_order_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                   String                 @id @db.VarChar(36)
  order_code           String                 @unique(map: "idx_orders_code") @db.VarChar(50)
  user_id              String?                @db.VarChar(64)
  customer_name        String                 @db.VarChar(100)
  customer_phone       String                 @db.VarChar(20)
  customer_email       String?                @db.VarChar(254)
  recipient_name       String?                @db.VarChar(100)
  recipient_phone      String?                @db.VarChar(20)
  is_gift              Boolean                @default(false)
  is_anonymous         Boolean                @default(false)
  shipping_address     String                 @db.VarChar(255)
  delivery_date        String?                @db.VarChar(20)
  delivery_slot        String?                @db.VarChar(100)
  has_greeting_card    Boolean                @default(false)
  card_message         String?                @db.Text
  customer_note        String?                @db.Text
  shipping_fee         Int                    @default(0)
  subtotal             Int                    @default(0)
  discount_amount      Int                    @default(0)
  total_amount         Int                    @default(0)
  status               String                 @default("pending") @db.VarChar(30)
  payment_method       String                 @default("cod") @db.VarChar(20)
  payment_status       String                 @default("pending") @db.VarChar(20)
  voucher_code         String?                @db.VarChar(50)
  created_at           DateTime               @default(now()) @db.DateTime(0)
  completed_at         DateTime?              @db.DateTime(0)
  notifications        notifications[]
  order_items          order_items[]
  users                users?                 @relation(fields: [user_id], references: [id], map: "fk_orders_user")
  payment_transactions payment_transactions[]
  refund_requests      refund_requests[]

  @@index([user_id], map: "fk_orders_user")
  @@index([status], map: "idx_orders_status")
  @@index([user_id, created_at], map: "idx_orders_user_created")
}

model refund_requests {
  id                String    @id @db.VarChar(36)
  order_id          String    @db.VarChar(36)
  amount            Int
  reason            String    @db.Text
  bank_info         String?   @db.VarChar(255)
  status            String    @default("pending_approval") @db.VarChar(30)
  requested_by_id   String?   @db.VarChar(64)
  requested_by_name String?   @db.VarChar(100)
  requested_at      DateTime  @default(now()) @db.DateTime(0)
  reviewed_by_id    String?   @db.VarChar(64)
  reviewed_by_name  String?   @db.VarChar(100)
  reviewed_at       DateTime? @db.DateTime(0)
  admin_note        String?   @db.Text
  refund_tx_ref     String?   @db.VarChar(100)
  orders            orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_refund_order")

  @@index([order_id], map: "fk_refund_order")
  @@index([status], map: "idx_refund_status")
}

model payment_transactions {
  id               String   @id @db.VarChar(36)
  order_id         String   @db.VarChar(36)
  provider         String   @default("sepay") @db.VarChar(50)
  provider_tx_id   String   @unique(map: "idx_sepay_provider_tx") @db.VarChar(100)
  amount           Int
  bank_brand       String?  @db.VarChar(50)
  account_number   String?  @db.VarChar(50)
  transaction_date DateTime @db.DateTime(0)
  created_at       DateTime @default(now()) @db.DateTime(0)
  orders           orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_pay_order")

  @@index([order_id], map: "fk_pay_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id             String           @id @db.VarChar(36)
  category_id    String           @db.VarChar(36)
  name           String           @db.VarChar(200)
  price          Int
  original_price Int
  cost_price     Int              @default(0)
  stock          Int              @default(0)
  image_url      String           @db.VarChar(255)
  description    String           @db.Text
  badge          String?          @db.VarChar(50)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.DateTime(0)
  order_items    order_items[]
  categories     categories       @relation(fields: [category_id], references: [id], onDelete: NoAction, map: "fk_products_category")
  reviews        reviews[]
  wishlist_items wishlist_items[]

  @@index([category_id], map: "fk_products_category")
  @@index([category_id, is_active], map: "idx_products_cat_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id                 String                 @id @db.VarChar(36)
  product_id         String                 @db.VarChar(36)
  user_id            String                 @db.VarChar(64)
  rating             Int                    @default(5) @db.TinyInt
  comment            String                 @db.Text
  images_json        String?                @db.Text
  helpful_count      Int                    @default(0)
  is_hidden          Boolean                @default(false)
  reply              String?                @db.Text
  reply_date         DateTime?              @db.DateTime(0)
  reply_by           String?                @db.VarChar(100)
  is_verified_buyer  Boolean                @default(false)
  edited_at          DateTime?              @db.DateTime(0)
  created_at         DateTime               @default(now()) @db.DateTime(0)
  products           products               @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_reviews_product")
  users              users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_reviews_user")
  helpful_votes      review_helpful_votes[]
  comments           review_comments[]

  @@unique([product_id, user_id], map: "idx_user_product_review")
  @@index([user_id], map: "fk_reviews_user")
  @@index([product_id, is_hidden], map: "idx_reviews_prod_hidden")
}

model review_comments {
  id                String   @id @db.VarChar(36)
  review_id         String   @db.VarChar(36)
  user_id           String   @db.VarChar(64)
  content           String   @db.Text
  is_verified_buyer Boolean  @default(false)
  created_at        DateTime @default(now()) @db.DateTime(0)
  reviews           reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade, map: "fk_rev_comment_review")
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_rev_comment_user")

  @@index([review_id, created_at], map: "idx_rev_comment_review_created")
  @@index([user_id], map: "fk_rev_comment_user")
}

model review_helpful_votes {
  id         String   @id @db.VarChar(36)
  review_id  String   @db.VarChar(36)
  user_id    String   @db.VarChar(64)
  created_at DateTime @default(now()) @db.DateTime(0)
  reviews    reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade, map: "fk_helpful_review")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_helpful_user")

  @@unique([review_id, user_id], map: "idx_review_helpful_unique")
  @@index([user_id], map: "fk_helpful_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                    String                  @id @db.VarChar(64)
  email                 String                  @unique(map: "idx_users_email")
  password_hash         String                  @db.VarChar(255)
  token_version         Int                     @default(1)
  name                  String                  @db.VarChar(100)
  phone                 String?                 @db.VarChar(20)
  role                  String                  @default("customer") @db.VarChar(20)
  avatar_url            String?                 @db.VarChar(255)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  notifications         notifications[]
  orders                orders[]
  reviews               reviews[]
  review_helpful_votes  review_helpful_votes[]
  review_comments       review_comments[]
  wishlist_items        wishlist_items[]
  password_reset_tokens password_reset_tokens[]
}

model password_reset_tokens {
  id         String    @id @db.VarChar(40)
  user_id    String    @db.VarChar(64)
  token_hash String    @unique(map: "idx_password_reset_token_hash") @db.Char(64)
  created_at DateTime  @default(now()) @db.DateTime(0)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_password_reset_user")

  @@index([user_id, expires_at], map: "idx_password_reset_user_expiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vouchers {
  id                  String    @id @db.VarChar(36)
  code                String    @unique(map: "idx_vouchers_code") @db.VarChar(50)
  name                String    @db.VarChar(100)
  discount_type       String    @default("percent") @db.VarChar(10)
  discount_value      Int
  min_order           Int       @default(0)
  max_discount        Int?
  scope               String    @default("all") @db.VarChar(20)
  target_category_ids String?   @db.Text
  target_product_ids  String?   @db.Text
  usage_limit         Int?
  used_count          Int       @default(0)
  start_date          DateTime? @db.DateTime(0)
  end_date            DateTime? @db.DateTime(0)
  is_active           Boolean   @default(true)
}

model wishlist_items {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(64)
  product_id String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.DateTime(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_wishlist_product")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_wishlist_user")

  @@unique([user_id, product_id], map: "idx_user_product_wishlist")
  @@index([product_id], map: "fk_wishlist_product")
}

model addons {
  id                String              @id @db.VarChar(36)
  name              String              @db.VarChar(100)
  price             Int
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  order_item_addons order_item_addons[]
}

model order_item_addons {
  id            String      @id @db.VarChar(36)
  order_item_id String      @db.VarChar(36)
  addon_id      String      @db.VarChar(36)
  addon_name    String      @db.VarChar(100)
  unit_price    Int
  created_at    DateTime    @default(now()) @db.DateTime(0)
  order_items   order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade, map: "fk_item_addon_order_item")
  addons        addons      @relation(fields: [addon_id], references: [id], onDelete: NoAction, map: "fk_item_addon_addon")

  @@index([order_item_id], map: "fk_item_addon_order_item")
  @@index([addon_id], map: "fk_item_addon_addon")
}
