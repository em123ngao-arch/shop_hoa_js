generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banners {
  id            String  @id @db.VarChar(36)
  title         String  @db.VarChar(255)
  image_url     String  @db.VarChar(255)
  link_url      String? @db.VarChar(255)
  display_order Int     @default(0)
  is_active     Boolean @default(true)
  tag           String? @db.VarChar(100)
  description   String? @db.Text
  theme         String? @default("default") @db.VarChar(50)
  cta_text      String? @default("Khám Phá Các Mẫu Hoa") @db.VarChar(100)
}

model categories {
  id          String     @id @db.VarChar(36)
  name        String     @db.VarChar(100)
  slug        String     @unique(map: "idx_categories_slug") @db.VarChar(100)
  description String?    @db.Text
  products    products[]
}

model notifications {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(64)
  order_id   String?  @db.VarChar(36)
  title      String   @db.VarChar(200)
  message    String   @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
  orders     orders?  @relation(fields: [order_id], references: [id], map: "fk_notif_order")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notif_user")

  @@index([order_id], map: "fk_notif_order")
  @@index([user_id], map: "fk_notif_user")
  @@index([user_id, is_read], map: "idx_notif_user_read")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                String              @id @db.VarChar(36)
  order_id          String              @db.VarChar(36)
  product_id        String              @db.VarChar(36)
  product_name      String              @db.VarChar(200)
  quantity          Int                 @default(1)
  unit_price        Int
  cost_price        Int                 @default(0)
  orders            orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_order_items_order")
  products          products            @relation(fields: [product_id], references: [id], onDelete: NoAction, map: "fk_order_items_product")
  order_item_addons order_item_addons[]

  @@index([order_id], map: "fk_order_items_order")
  @@index([product_id], map: "fk_order_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                       String                        @id @db.VarChar(36)
  order_code               String                        @unique(map: "idx_orders_code") @db.VarChar(50)
  user_id                  String?                       @db.VarChar(64)
  customer_name            String                        @db.VarChar(100)
  customer_phone           String                        @db.VarChar(20)
  customer_email           String?                       @db.VarChar(254)
  recipient_name           String?                       @db.VarChar(100)
  recipient_phone          String?                       @db.VarChar(20)
  is_gift                  Boolean                       @default(false)
  is_anonymous             Boolean                       @default(false)
  shipping_address         String                        @db.VarChar(255)
  delivery_area            String?                       @db.VarChar(100)
  delivery_zone            String?                       @db.VarChar(40)
  delivery_place_id        String?                       @db.VarChar(255)
  delivery_distance_meters Int?
  delivery_snap_offset_meters Int?
  delivery_route_provider String?                    @db.VarChar(40)
  delivery_rate_version   String?                       @db.VarChar(40)
  delivery_latitude        Float?                        @db.Double
  delivery_longitude       Float?                        @db.Double
  delivery_quote_at        DateTime?                     @db.DateTime(0)
  delivery_quote_request_id String?                       @unique(map: "uq_orders_delivery_quote_request") @db.VarChar(36)
  delivery_date            String?                       @db.VarChar(20)
  delivery_slot            String?                       @db.VarChar(100)
  has_greeting_card        Boolean                       @default(false)
  card_message             String?                       @db.Text
  customer_note            String?                       @db.Text
  shipping_fee             Int                           @default(0)
  subtotal                 Int                           @default(0)
  discount_amount          Int                           @default(0)
  total_amount             Int                           @default(0)
  status                   String                        @default("pending") @db.VarChar(30)
  payment_method           String                        @default("cod") @db.VarChar(20)
  payment_plan             String                        @default("legacy_cod") @db.VarChar(40)
  payment_status           String                        @default("pending") @db.VarChar(20)
  terms_version            String?                       @db.VarChar(40)
  terms_accepted_at        DateTime?                     @db.DateTime(0)
  voucher_code             String?                       @db.VarChar(50)
  created_at               DateTime                      @default(now()) @db.DateTime(0)
  completed_at             DateTime?                     @db.DateTime(0)
  cancelled_at             DateTime?                     @db.DateTime(0)
  notifications            notifications[]
  order_items              order_items[]
  users                    users?                        @relation(fields: [user_id], references: [id], map: "fk_orders_user")
  payment_transactions     payment_transactions[]
  payment_intents          payment_intents[]
  payment_entries          order_payment_entries[]
  delivery_attempts        delivery_attempts[]
  change_requests          order_change_requests[]
  cancellation_requests    order_cancellation_requests[]
  refund_requests          refund_requests[]
  delivery_quote_request   delivery_quote_requests?      @relation(fields: [delivery_quote_request_id], references: [id], onDelete: SetNull, map: "fk_order_delivery_quote_request")

  @@index([user_id], map: "fk_orders_user")
  @@index([status], map: "idx_orders_status")
  @@index([user_id, created_at], map: "idx_orders_user_created")
}

model refund_requests {
  id                String    @id @db.VarChar(36)
  order_id          String    @db.VarChar(36)
  amount            Int
  reason            String    @db.Text
  bank_info         String?   @db.VarChar(255)
  status            String    @default("pending_approval") @db.VarChar(30)
  requested_by_id   String?   @db.VarChar(64)
  requested_by_name String?   @db.VarChar(100)
  requested_at      DateTime  @default(now()) @db.DateTime(0)
  reviewed_by_id    String?   @db.VarChar(64)
  reviewed_by_name  String?   @db.VarChar(100)
  reviewed_at       DateTime? @db.DateTime(0)
  admin_note        String?   @db.Text
  refund_tx_ref     String?   @db.VarChar(100)
  orders            orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_refund_order")

  @@index([order_id], map: "fk_refund_order")
  @@index([status], map: "idx_refund_status")
}

model payment_transactions {
  id                String           @id @db.VarChar(36)
  order_id          String           @db.VarChar(36)
  provider          String           @default("sepay") @db.VarChar(50)
  provider_tx_id    String           @unique(map: "idx_sepay_provider_tx") @db.VarChar(100)
  amount            Int
  bank_brand        String?          @db.VarChar(50)
  account_number    String?          @db.VarChar(50)
  transaction_date  DateTime         @db.DateTime(0)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  payment_intent_id String?          @db.VarChar(36)
  orders            orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_pay_order")
  payment_intents   payment_intents? @relation(fields: [payment_intent_id], references: [id], onDelete: SetNull, map: "fk_payment_tx_intent")

  @@index([order_id], map: "fk_pay_order")
  @@index([payment_intent_id], map: "fk_payment_tx_intent")
}

model payment_intents {
  id                   String                  @id @db.VarChar(36)
  order_id             String                  @db.VarChar(36)
  purpose              String                  @db.VarChar(40)
  reference_code       String                  @unique(map: "idx_payment_intent_reference") @db.VarChar(32)
  amount               Int
  related_request_id   String?                 @db.VarChar(36)
  received_amount      Int                     @default(0)
  status               String                  @default("pending") @db.VarChar(20)
  expires_at           DateTime?               @db.DateTime(0)
  created_at           DateTime                @default(now()) @db.DateTime(0)
  paid_at              DateTime?               @db.DateTime(0)
  orders               orders                  @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_payment_intent_order")
  payment_transactions payment_transactions[]
  payment_entries      order_payment_entries[]

  @@index([order_id, status], map: "idx_payment_intent_order_status")
}

model order_payment_entries {
  id                String           @id @db.VarChar(36)
  order_id          String           @db.VarChar(36)
  payment_intent_id String?          @db.VarChar(36)
  entry_type        String           @db.VarChar(40)
  direction         String           @db.VarChar(10)
  channel           String           @db.VarChar(30)
  amount            Int
  external_ref      String?          @unique(map: "idx_order_payment_entry_ref") @db.VarChar(120)
  note              String?          @db.VarChar(500)
  actor_id          String?          @db.VarChar(64)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  orders            orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_payment_entry_order")
  payment_intents   payment_intents? @relation(fields: [payment_intent_id], references: [id], onDelete: SetNull, map: "fk_payment_entry_intent")

  @@index([order_id, created_at], map: "idx_payment_entry_order_created")
  @@index([payment_intent_id], map: "idx_payment_entry_intent")
}

model delivery_attempts {
  id                  String    @id @db.VarChar(36)
  order_id            String    @db.VarChar(36)
  attempt_number      Int
  status              String    @db.VarChar(20)
  started_at          DateTime  @default(now()) @db.DateTime(0)
  failed_at           DateTime? @db.DateTime(0)
  completed_at        DateTime? @db.DateTime(0)
  fail_reason         String?   @db.VarChar(255)
  contact_log         String?   @db.Text
  fee_charged         Int       @default(0)
  reschedule_deadline DateTime? @db.DateTime(0)
  reminder_sent_at    DateTime? @db.DateTime(0)
  created_by_id       String?   @db.VarChar(64)
  orders              orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_delivery_attempt_order")

  @@unique([order_id, attempt_number], map: "uq_delivery_attempt_number")
  @@index([order_id, status], map: "idx_delivery_attempt_order_status")
  @@index([reschedule_deadline], map: "idx_delivery_reschedule_deadline")
}

model delivery_quote_requests {
  id                    String    @id @db.VarChar(36)
  request_code          String    @unique(map: "uq_delivery_quote_request_code") @db.VarChar(20)
  user_id               String?   @db.VarChar(64)
  customer_name         String    @db.VarChar(100)
  customer_phone        String    @db.VarChar(20)
  customer_email        String?   @db.VarChar(254)
  shipping_address      String    @db.VarChar(255)
  delivery_area         String    @db.VarChar(100)
  delivery_latitude     Float?    @db.Double
  delivery_longitude    Float?    @db.Double
  delivery_distance_meters Int?
  delivery_snap_offset_meters Int?
  delivery_route_provider String? @db.VarChar(40)
  delivery_date         String?   @db.VarChar(20)
  delivery_slot         String?   @db.VarChar(100)
  quoted_delivery_date  String?   @db.VarChar(20)
  quoted_delivery_slot  String?   @db.VarChar(100)
  payment_plan          String    @default("sepay_full") @db.VarChar(40)
  payload_json          String    @db.LongText
  status                String    @default("requested") @db.VarChar(24)
  quoted_shipping_fee   Int?
  shop_note             String?   @db.Text
  quote_expires_at      DateTime? @db.DateTime(0)
  reviewed_by_id        String?   @db.VarChar(64)
  reviewed_at           DateTime? @db.DateTime(0)
  accepted_at           DateTime? @db.DateTime(0)
  created_at            DateTime  @default(now()) @db.DateTime(0)
  updated_at            DateTime  @updatedAt @db.DateTime(0)
  users                 users?    @relation(fields: [user_id], references: [id], onDelete: SetNull, map: "fk_delivery_quote_user")
  orders                orders?

  @@index([status, created_at], map: "idx_delivery_quote_status_created")
  @@index([customer_phone, created_at], map: "idx_delivery_quote_phone_created")
  @@index([quote_expires_at], map: "idx_delivery_quote_expiry")
  @@index([user_id], map: "idx_delivery_quote_user")
}

model order_change_requests {
  id                    String    @id @db.VarChar(36)
  order_id              String    @db.VarChar(36)
  change_type           String    @db.VarChar(30)
  old_value             String    @db.Text
  new_value             String    @db.Text
  added_fee             Int       @default(0)
  status                String    @default("pending") @db.VarChar(20)
  requested_at          DateTime  @default(now()) @db.DateTime(0)
  reviewed_at           DateTime? @db.DateTime(0)
  reviewed_by_id        String?   @db.VarChar(64)
  customer_confirmed_at DateTime? @db.DateTime(0)
  orders                orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_order_change_order")

  @@index([order_id, status], map: "idx_order_change_order_status")
}

model order_cancellation_requests {
  id                  String    @id @db.VarChar(36)
  order_id            String    @db.VarChar(36)
  requested_by        String    @db.VarChar(20)
  reason              String    @db.Text
  cost_breakdown_json String?   @db.Text
  evidence_note       String?   @db.Text
  deductible_amount   Int       @default(0)
  refund_amount       Int       @default(0)
  status              String    @default("pending") @db.VarChar(20)
  requested_at        DateTime  @default(now()) @db.DateTime(0)
  reviewed_at         DateTime? @db.DateTime(0)
  reviewed_by_id      String?   @db.VarChar(64)
  orders              orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_order_cancel_order")

  @@index([order_id, status], map: "idx_order_cancel_order_status")
}

model unmatched_payment_transactions {
  id               String    @id @db.VarChar(36)
  provider_tx_id   String    @unique(map: "uq_unmatched_payment_provider_tx") @db.VarChar(100)
  amount           Int
  payment_content  String    @db.VarChar(255)
  bank_brand       String?   @db.VarChar(50)
  account_suffix   String?   @db.VarChar(8)
  transaction_date DateTime  @db.DateTime(0)
  status           String    @default("unmatched") @db.VarChar(20)
  resolution_note  String?   @db.VarChar(500)
  reviewed_by_id   String?   @db.VarChar(64)
  reviewed_at      DateTime? @db.DateTime(0)
  created_at       DateTime  @default(now()) @db.DateTime(0)

  @@index([status, created_at], map: "idx_unmatched_payment_status_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id             String           @id @db.VarChar(36)
  category_id    String           @db.VarChar(36)
  name           String           @db.VarChar(200)
  price          Int
  original_price Int
  cost_price     Int              @default(0)
  stock          Int              @default(0)
  image_url      String           @db.VarChar(255)
  description    String           @db.Text
  badge          String?          @db.VarChar(50)
  color          String?          @default("ket-hop") @db.VarChar(50)
  flower_type    String?          @default("khac") @db.VarChar(50)
  occasion       String?          @default("tat-ca") @db.VarChar(50)
  material       String?          @default("kem-nhung") @db.VarChar(50)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.DateTime(0)
  order_items    order_items[]
  categories     categories       @relation(fields: [category_id], references: [id], onDelete: NoAction, map: "fk_products_category")
  reviews        reviews[]
  wishlist_items wishlist_items[]

  @@index([category_id], map: "fk_products_category")
  @@index([category_id, is_active], map: "idx_products_cat_active")
  @@index([color], map: "idx_products_color")
  @@index([flower_type], map: "idx_products_flower_type")
  @@index([occasion], map: "idx_products_occasion")
  @@index([material], map: "idx_products_material")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id                String                 @id @db.VarChar(36)
  product_id        String                 @db.VarChar(36)
  user_id           String                 @db.VarChar(64)
  rating            Int                    @default(5) @db.TinyInt
  comment           String                 @db.Text
  images_json       String?                @db.Text
  helpful_count     Int                    @default(0)
  is_hidden         Boolean                @default(false)
  reply             String?                @db.Text
  reply_date        DateTime?              @db.DateTime(0)
  reply_by          String?                @db.VarChar(100)
  is_verified_buyer Boolean                @default(false)
  edited_at         DateTime?              @db.DateTime(0)
  created_at        DateTime               @default(now()) @db.DateTime(0)
  products          products               @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_reviews_product")
  users             users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_reviews_user")
  helpful_votes     review_helpful_votes[]
  comments          review_comments[]

  @@unique([product_id, user_id], map: "idx_user_product_review")
  @@index([user_id], map: "fk_reviews_user")
  @@index([product_id, is_hidden], map: "idx_reviews_prod_hidden")
}

model review_comments {
  id                String   @id @db.VarChar(36)
  review_id         String   @db.VarChar(36)
  user_id           String   @db.VarChar(64)
  content           String   @db.Text
  is_verified_buyer Boolean  @default(false)
  created_at        DateTime @default(now()) @db.DateTime(0)
  reviews           reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade, map: "fk_rev_comment_review")
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_rev_comment_user")

  @@index([review_id, created_at], map: "idx_rev_comment_review_created")
  @@index([user_id], map: "fk_rev_comment_user")
}

model review_helpful_votes {
  id         String   @id @db.VarChar(36)
  review_id  String   @db.VarChar(36)
  user_id    String   @db.VarChar(64)
  created_at DateTime @default(now()) @db.DateTime(0)
  reviews    reviews  @relation(fields: [review_id], references: [id], onDelete: Cascade, map: "fk_helpful_review")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_helpful_user")

  @@unique([review_id, user_id], map: "idx_review_helpful_unique")
  @@index([user_id], map: "fk_helpful_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                    String                  @id @db.VarChar(64)
  email                 String                  @unique(map: "idx_users_email")
  password_hash         String                  @db.VarChar(255)
  token_version         Int                     @default(1)
  name                  String                  @db.VarChar(100)
  phone                 String?                 @db.VarChar(20)
  role                  String                  @default("customer") @db.VarChar(20)
  avatar_url            String?                 @db.VarChar(255)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  notifications         notifications[]
  orders                orders[]
  delivery_quote_requests delivery_quote_requests[]
  reviews               reviews[]
  review_helpful_votes  review_helpful_votes[]
  review_comments       review_comments[]
  wishlist_items        wishlist_items[]
  password_reset_tokens password_reset_tokens[]
}

model password_reset_tokens {
  id         String    @id @db.VarChar(40)
  user_id    String    @db.VarChar(64)
  token_hash String    @unique(map: "idx_password_reset_token_hash") @db.Char(64)
  created_at DateTime  @default(now()) @db.DateTime(0)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_password_reset_user")

  @@index([user_id, expires_at], map: "idx_password_reset_user_expiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vouchers {
  id                  String    @id @db.VarChar(36)
  code                String    @unique(map: "idx_vouchers_code") @db.VarChar(50)
  name                String    @db.VarChar(100)
  discount_type       String    @default("percent") @db.VarChar(10)
  discount_value      Int
  min_order           Int       @default(0)
  max_discount        Int?
  scope               String    @default("all") @db.VarChar(20)
  target_category_ids String?   @db.Text
  target_product_ids  String?   @db.Text
  usage_limit         Int?
  used_count          Int       @default(0)
  start_date          DateTime? @db.DateTime(0)
  end_date            DateTime? @db.DateTime(0)
  is_active           Boolean   @default(true)
}

model wishlist_items {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(64)
  product_id String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.DateTime(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_wishlist_product")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_wishlist_user")

  @@unique([user_id, product_id], map: "idx_user_product_wishlist")
  @@index([product_id], map: "fk_wishlist_product")
}

model addons {
  id                String              @id @db.VarChar(36)
  name              String              @db.VarChar(100)
  price             Int
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  order_item_addons order_item_addons[]
}

model order_item_addons {
  id            String      @id @db.VarChar(36)
  order_item_id String      @db.VarChar(36)
  addon_id      String      @db.VarChar(36)
  addon_name    String      @db.VarChar(100)
  unit_price    Int
  created_at    DateTime    @default(now()) @db.DateTime(0)
  order_items   order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade, map: "fk_item_addon_order_item")
  addons        addons      @relation(fields: [addon_id], references: [id], onDelete: NoAction, map: "fk_item_addon_addon")

  @@index([order_item_id], map: "fk_item_addon_order_item")
  @@index([addon_id], map: "fk_item_addon_addon")
}
