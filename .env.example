# Port may chu Node.js
PORT=4000

# Cong thanh toan SePay VietQR (Thay bang token cua ban)
SEPAY_API_TOKEN=your_sepay_api_token_here
SEPAY_BANK_CODE=Sacombank
SEPAY_ACCOUNT_NUMBER=your_account_number_here
SEPAY_ACCOUNT_HOLDER=YOUR_ACCOUNT_HOLDER_NAME

# Gemini API Key Server-side
GEMINI_API_KEY=your_gemini_api_key_here

# Ket noi CSDL MySQL 8.0 (Tao user rieng cho ung dung)
DATABASE_URL="mysql://shop_hoa_user:your_secure_password@localhost:3306/shop_hoa_db"

# Khoa bi mat ky JWT Token (Toi thieu 64 ky tu hex)
JWT_SECRET=your_jwt_secret_random_hex_here

# Che do Demo danh rieng cho buoi bao ve do an (false = tat hoan toan)
DEMO_MODE=false

