# Port may chu Node.js
PORT=4000

# Cong thanh toan SePay VietQR (Thay bang token cua ban)
SEPAY_API_TOKEN=your_sepay_api_token_here
SEPAY_BANK_CODE=Sacombank
SEPAY_ACCOUNT_NUMBER=your_account_number_here
SEPAY_ACCOUNT_HOLDER=YOUR_ACCOUNT_HOLDER_NAME

# Gemini API Key Server-side
GEMINI_API_KEY=your_gemini_api_key_here

# Ket noi CSDL MySQL 8.0 (Tao user rieng cho ung dung)
DATABASE_URL="mysql://shop_hoa_user:your_secure_password@localhost:3306/shop_hoa_db"

# Khoa bi mat ky JWT Token (Toi thieu 64 ky tu hex)
JWT_SECRET=replace_with_at_least_64_random_characters_generated_for_this_environment

# Danh sach origin duoc phep truy cap API (phan cach bang dau phay; bo trong neu cung origin)
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://127.0.0.1:5173

# SMTP quên mật khẩu (để trống sẽ tắt gửi email; API vẫn trả phản hồi chung)
APP_BASE_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# API Key SePay webhook: cau hinh cung mot gia tri trong trang quan tri SePay
SEPAY_WEBHOOK_API_KEY=replace_with_sepay_webhook_api_key

# Che do Demo danh rieng cho buoi bao ve do an (false = tat hoan toan)
DEMO_MODE=false

# Cloudinary luu tru anh vinh vien tren CDN (25GB Free, khong can the)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

